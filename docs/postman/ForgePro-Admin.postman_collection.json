{
  "info": {
    "_postman_id": "78a9c80d-8302-4ab1-864f-e5df4859218d",
    "name": "ForgePro-Admin API Collection",
    "description": "Koleksi Postman v2.1 resmi untuk seluruh endpoint backend panel admin web ForgePro.id, terorganisir per tag fungsional.",
